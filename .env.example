# File: .env.example
# Summary: Non-secret examples for the public project; copy values into your own local environment.
# This file is documentation. Deployment scripts do not load it automatically.
JITSI_DOMAIN=meet.example.com
JITSI_AI_ORIGIN=https://meet.example.com
JITSI_SSH_HOST=meet.example.com
JITSI_SSH_USER=ubuntu
# Verify the host fingerprint through an independent trusted channel before configuring it.
JITSI_SSH_FINGERPRINT=
JITSI_SSH_PASSWORD=
